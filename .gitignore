# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ─── Build output ────────────────────────────────────────────────────────────
dist/
src-tauri/target/
*.tsbuildinfo

# ─── Generated build inputs ──────────────────────────────────────────────────
# Tauri regenerates these from tauri.conf.json / capabilities on build.
src-tauri/gen/schemas/

# The installer contains no Java runtime and no server JAR. The Clinic Server is a
# separate application on a separate machine, so there is nothing large to stage here.
# Anything under src-tauri/resources/ appearing again is a mistake, not an input.

# ─── Local environment & secrets ─────────────────────────────────────────────
.env
.env.local
.env.*.local

# ─── Logs & diagnostics ───────────────────────────────────────────────────────
*.log
tsc-output.txt
error-log.txt
hs_err_pid*.log

# ─── Local runtime artifacts ─────────────────────────────────────────────────
# Stray database files that land in the repo root during manual testing. The app
# itself keeps no local database.
*.db
*.mv.db
*.trace.db
clinic_server_license.json
jwt-secret.key

# ─── OS / editor noise ───────────────────────────────────────────────────────
Thumbs.db
.DS_Store
.vscode/
.idea/
*.swp
