{
  "name": "zeyara-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/prepare-jre.mjs && node scripts/sync-server-jar.mjs",
    "build": "tsc && vite build",
    "sync-server": "node scripts/sync-server-jar.mjs",
    "typecheck": "tsc --noEmit",
    "contract:smoke": "node scripts/contract-smoke.mjs",
    "contract:smoke:writes": "node scripts/contract-smoke.mjs --with-writes",
    "contract:endpoints": "node scripts/contract-endpoints.mjs --server ../Server/clinic-server",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "~5.7",
    "vite": "^6"
  },
  "dependencies": {
    "@emotion/cache": "^11",
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@fontsource/cairo": "^5",
    "@mui/icons-material": "^6",
    "@mui/material": "^6",
    "@tanstack/react-query": "^5",
    "@tauri-apps/api": "^2",
    "@vitejs/plugin-react": "^4",
    "esbuild": "^0.24",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7",
    "stylis": "^4",
    "stylis-plugin-rtl": "^2",
    "zustand": "^5"
  }
}
