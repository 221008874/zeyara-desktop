{
  "name": "zeyara-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "import:javafox": "node --experimental-sqlite scripts/import-javafox-data.mjs",
    "typecheck": "tsc --noEmit",
    "contract:smoke": "node scripts/contract-smoke.mjs",
    "contract:smoke:writes": "node scripts/contract-smoke.mjs --with-writes",
    "contract:endpoints": "node scripts/contract-endpoints.mjs --server ../Server/clinic-server",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^25.0.1",
    "typescript": "~5.7",
    "vite": "^6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@emotion/cache": "^11",
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@fontsource/cairo": "^5",
    "@mui/icons-material": "^6",
    "@mui/material": "^6",
    "@mui/x-charts": "^8.29.3",
    "@tanstack/react-query": "^5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-updater": "^2.13.0",
    "@vitejs/plugin-react": "^4",
    "esbuild": "^0.24",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7",
    "stylis": "^4",
    "stylis-plugin-rtl": "^2",
    "zustand": "^5"
  }
}
